<div class="container">
  <div class="form-card">
    <h1>Edit Project</h1>

    <% if @project.errors.any? %>
      <div class="error-message">
        <h2><%= pluralize(@project.errors.count, "error") %> prohibited this project:</h2>
        <ul>
          <% @project.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with(model: @project, local: true) do |form| %>
      <div class="form-group">
        <%= form.label :name %>
        <%= form.text_field :name %>
      </div>

      <div class="form-group">
        <%= form.label :description %>
        <%= form.text_area :description, rows: 5 %>
      </div>

      <div class="form-actions">
        <%= form.submit "Update Project", class: "btn btn-primary" %>
        <%= link_to "Cancel", project_path(@project), class: "btn btn-secondary" %>
      </div>
    <% end %>
  </div>
</div>
