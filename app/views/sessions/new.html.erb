<div class="container">
  <div class="card">
    <h1>Log In</h1>

    <% if flash[:alert] %>
      <div class="alert alert-danger">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <%= form_with(url: sessions_path, local: true) do |form| %>
      <div class="form-group">
        <%= form.label :email %>
        <%= form.email_field :email, placeholder: "your@email.com" %>
      </div>

      <div class="form-group">
        <%= form.label :password %>
        <%= form.password_field :password, placeholder: "Password" %>
      </div>

      <div class="form-actions">
        <%= form.submit "Log In", class: "btn btn-primary" %>
      </div>
    <% end %>

    <p class="text-center">
      Don't have an account? <%= link_to "Sign up", new_user_path %>
    </p>
  </div>
</div>
